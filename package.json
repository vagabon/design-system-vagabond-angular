{
  "name": "ng-vagabon-lab",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm-run-all --parallel lib:watch showcase:start-waiton",
    "build": "run-s lib:build showcase:build",
    "test": "vitest --config vite.config.ts",
    "test:coverage": "npm run test -- --no-watch --coverage",
    "lib:build": "ng build @ng-vagabond-lab/ng-dsv",
    "lib:watch": "ng build @ng-vagabond-lab/ng-dsv --watch --configuration development",
    "showcase:start-waiton": "wait-on dist/ng-vagabon-lib/ng-dsv/package.json && npm run showcase:start",
    "showcase:start": "ng serve showcase",
    "showcase:build": "ng build showcase",
    "storybook": "ng run @ng-vagabond-lab/ng-dsv:storybook",
    "storybook:build": "ng run @ng-vagabond-lab/ng-dsv:build-storybook",
    "sonar": "npm run test:coverage && npx sonar-scanner -Dsonar.token=$SONAR_TOKEN -Dsonar.host.url=http://localhost:9000"
  },
  "dependencies": {
    "@angular/cli": "^22.1.6",
    "@angular/common": "~22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/compiler-cli": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@ngx-translate/core": "~18.0.0",
    "marked": "^18.0.11",
    "ngx-markdown": "^22.0.2",
    "remixicon": "~4.9.1",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": "~22.0.7",
    "@ngx-translate/core": "~18.0.0",
    "remixicon": "~4.9.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@angular-devkit/build-angular": "^21.2.22",
    "@angular/build": "^22.1.6",
    "@chromatic-com/storybook": "^5.3.0",
    "@compodoc/compodoc": "^2.0.0",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/angular": "^10.5.10",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "happy-dom": "^20.12.0",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.9.6",
    "rxjs": "^7.8.2",
    "storybook": "^10.5.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
